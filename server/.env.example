
PORT=3000
BASE_URL=http://localhost:3000

CORS_ORIGIN=http://localhost:3001


# --------------------------------------------------------- mailboxes (Postgres)
# Only the Gmail connections live in Postgres; everything else stays in memory. With
# DATABASE_URL unset the app still boots and every other feature works - only
# /mailboxes returns 503.
#
#   docker compose up -d db     # from the repo root, binds host port 5433
#   npm run db:migrate          # creates the table
#
# Port 5433, not 5432, because a local Postgres service usually already owns 5432.
# Point this at your own instance instead if you prefer.
DATABASE_URL=postgresql://crm:crm@localhost:5433/crm

# Encrypts the Gmail tokens before they are written. 64 hex characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it makes every stored token undecryptable, so people have to reconnect.
TOKEN_ENCRYPTION_KEY=

# OAuth client from https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must be exactly GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/mailboxes/google/callback

# Where the callback sends the browser back to once the mailbox is connected.
APP_URL=http://localhost:3001

# ------------------------------------------------------------------- web agent
# Powers the "Web agent" workflow block, which researches a record on the web and
# fills in blank attributes. Without a key the block logs "skipped" and the rest of
# the workflow carries on, so the demo works either way.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=         # required
OPENROUTER_MODEL=mistralai/mistral-nemo         # optional
OPENROUTER_APP_TITLE=        # optional
# Tried in order when the model above is rate limited. Defaults to three other free
# models; add a paid id here if the block has to succeed every time.
OPENROUTER_FALLBACKS=        # optional, comma separated

# How a sequence picks its transport, per message, on the From address:
#   1. that address has a mailbox connected  -> sent through Gmail, as them
#   2. otherwise                             -> Resend, then SMTP, then the console
# So these stay the fallback. With no mailbox connected nothing below changes.
RESEND_API_KEY=

RESEND_FROM=onboarding@resend.dev

# SMTP alternative (Gmail, SES, Postmark, ...). Ignored when RESEND_API_KEY is set.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ------------------------------------------------------------------------ demo
# SEED=1 creates the "Two-Step Email Follow-Up for People" sequence and two workflows.
SEED=1
# FAST_DEMO=1 makes one business day last 10 seconds and ignores the sending window,
# so a two-step sequence finishes while you watch. Never set this in production.
FAST_DEMO=0
# How often the sequence runner looks for emails that are due, in milliseconds.
# SEQUENCE_TICK_MS=30000

# Fallback sender for the seeded sequence.
DEFAULT_SENDER=team@hyring.example
