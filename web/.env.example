# Copy to .env.local. Both settings are optional.

# Where the NestJS API is running. The UI proxies /api/* here (see next.config.ts),
# so the browser never makes a cross-origin request.
API_ORIGIN=http://localhost:3000

# Set this to skip the proxy and call the API straight from the browser instead.
# The API sends CORS headers; narrow them with CORS_ORIGIN on the server.
# NEXT_PUBLIC_API_URL=http://localhost:3000
